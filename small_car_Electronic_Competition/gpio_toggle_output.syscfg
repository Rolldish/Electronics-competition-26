GPIO6.$name                         = "OLED_RST";
GPIO6.associatedPins[0].$name       = "PIN_RST";
GPIO6.associatedPins[0].pin.$assign = "PB14";

GPIO7.$name                         = "OLED_DC";
GPIO7.associatedPins[0].$name       = "PIN_DC";
